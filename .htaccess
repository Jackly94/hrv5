SetEnv APP_BASE_PATH /hronline

RewriteEngine On
RewriteBase /hronline/

RewriteRule ^(assets|images|files)(/.*)?$ public/$0 [L]
RewriteRule ^(favicon\.ico|favicon\.svg|robots\.txt)$ public/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [L]
