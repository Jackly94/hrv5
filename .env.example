# Local environment configuration.
# Copy this file to .env and adjust as needed.
# In production, set environment variables via server or container configuration instead.
APP_ENV=dev
APP_DEBUG=true

# Yii3 database configuration.
# If these are not set, local development falls back to ../staff/config/db.php
# while the Yii2-to-Yii3 migration is still running side by side.
HRONLINE_DB_DSN=mysql:host=127.0.0.1;dbname=hronline
HRONLINE_DB_USERNAME=root
HRONLINE_DB_PASSWORD=

# Additional Yii2-compatible DB connection names are supported with the same pattern.
# Define only the connections needed by the migrated Yii3 feature.
# HRONLINE_DB2_DSN=mysql:host=127.0.0.1;dbname=hronline
# HRONLINE_DB2_USERNAME=root
# HRONLINE_DB2_PASSWORD=
# HRONLINE_DB3_DSN=sqlsrv:Server=127.0.0.1;Database=Finance
# HRONLINE_DB3_USERNAME=
# HRONLINE_DB3_PASSWORD=
